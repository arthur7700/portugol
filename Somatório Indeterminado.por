programa {
  funcao inicio() {
        inteiro num, soma = 0
    
    enquanto(num != 0){

      escreva("Digite o numero para somar,(e 0 para parar):")
      leia(num)
      soma = soma + num
      escreva("A soma atual e:", soma, "\n")
   escreva("A soma dos numeros e:", soma, "\n")
   escreva("trabalho finalizado!!!")
    }

    }
  }

